{
  "id": "./",
  "name": "Kaha Gaya Mera Paisa",
  "short_name": "Mera Paisa",
  "description": "Filmy, Gen-Z money tracker — kharcha, income, cards, EMIs, udhaar, budgets, sapne, aura points and memes. Free forever.",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0b0a10",
  "theme_color": "#7c3aed",
  "categories": ["finance", "lifestyle", "productivity"],
  "lang": "en-IN",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Kharcha add karo", "short_name": "Add", "url": "./?tab=home&source=shortcut", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Jaadu Scanner", "short_name": "Scan", "url": "./?tab=jaadu&source=shortcut", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Paisa Wrapped", "short_name": "Wrapped", "url": "./?tab=wrapped&source=shortcut", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "EMIs & Bills", "short_name": "EMIs", "url": "./?tab=kist&source=shortcut", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "files", "accept": ["image/*", "application/pdf", "text/csv", ".csv", ".xls", ".xlsx"] }]
    }
  }
}
